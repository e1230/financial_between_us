# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored; never commit it.
#
# Loaded at startup by flutter_dotenv (`dotenv.load(fileName: '.env')` in main.dart)
# and bundled as an asset (see pubspec.yaml). Read values with:
#   dotenv.env['CLOUDINARY_CLOUD_NAME']

# Cloudinary (receipt photos) — unsigned upload preset only.
# NEVER put the Cloudinary API secret here: everything in this file ends up inside the APK.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Notifications Worker (workers/notifications): its public URL, without a
# trailing path. It only receives "this happened" + the user's ID token; the
# Firebase service account lives in the Worker as a secret, never here.
# Without it the app works but sends no push notifications.
NOTIFICATIONS_WORKER_URL=https://fbu-notifications.your-subdomain.workers.dev
