rules_version = '2';

// Security rules of Financial Between Us.
// Publish them with `firebase deploy --only firestore:rules` (or paste them
// in Firebase Console → Firestore → Rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupDoc(gid) {
      return /databases/$(database)/documents/groups/$(gid);
    }

    // Admins of a group document, in promotion order (the owner first).
    // Older documents without `admins` have the owner as their only admin.
    function adminsOf(group) {
      return group.get('admins', [group.ownerUid]);
    }

    function indexDoc(uid) {
      return /databases/$(database)/documents/userGroups/$(uid);
    }

    // Groups where `uid` is an active member (see userGroups below).
    function groupIdsOf(uid) {
      return exists(indexDoc(uid)) ? get(indexDoc(uid)).data.groupIds : [];
    }

    // The signed-in user and `uid` are active members of a same group.
    function sharesGroupWith(uid) {
      return signedIn() && groupIdsOf(request.auth.uid).hasAny(groupIdsOf(uid));
    }

    // ---------------------------------------------------------------
    // Collection group queries of movements: the history of a person in
    // "Todos los grupos". Only the user's own movements (they are a party),
    // so the query must filter `participants array-contains` their uid.
    // Note: it also lets someone who left a group page their own movements
    // there; reading the whole group still needs being an active member.
    // ---------------------------------------------------------------
    match /{path=**}/movements/{movementId} {
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
    }

    // ---------------------------------------------------------------
    // nicknames/{nickname} → { uid, email }
    // Unique nickname index; also used to sign in with the nickname.
    // ---------------------------------------------------------------
    match /nicknames/{nickname} {
      // Needed to sign in with a nickname (before there is a session).
      // Note: whoever knows a nickname can read its email. Acceptable for a
      // group of up to 10 friends; the private alternative is a Cloud
      // Function (Blaze plan).
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && nickname.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      // A nickname never changes hands.
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // users/{uid}
    // ---------------------------------------------------------------
    match /users/{uid} {
      function profileKeys() {
        return ['displayName', 'nickname', 'email', 'photoUrl', 'color',
                'profileCompleted', 'createdAt', 'updatedAt', 'deletedAt'];
      }

      function validProfile(d) {
        return d.keys().hasOnly(profileKeys())
          && d.displayName is string
          && d.displayName.size() > 0
          && d.displayName.size() <= 40
          && d.email is string
          && (d.photoUrl == null
              || (d.photoUrl is string
                  && d.photoUrl.matches('^https://res[.]cloudinary[.]com/.+')))
          && d.color is string
          && d.color.matches('^#[0-9A-Fa-f]{6}$')
          && d.profileCompleted is bool;
      }

      // Friends see each other's nickname, name, photo and color.
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.profileCompleted == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.deletedAt == null
        // Created in the same transaction that reserves the nickname.
        && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.nickname)).data.uid == uid;

      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).unchangedKeys()
             .hasAll(['nickname', 'email', 'createdAt', 'deletedAt'])
        && request.resource.data.updatedAt == request.time;

      // Nothing is physically deleted (soft delete with `deletedAt`).
      allow delete: if false;

      // users/{uid}/paymentAccounts/{accountId}
      //   → { name, type, keyType, reference, createdAt, updatedAt, deletedAt }
      // Where the user receives payments. They belong to the user, not to a
      // group: only the owner writes them, and whoever shares an active
      // group with them can read them (to pay them).
      match /paymentAccounts/{accountId} {
        function validAccount(d) {
          return d.keys().hasOnly(['name', 'type', 'keyType', 'reference',
                                   'createdAt', 'updatedAt', 'deletedAt'])
            && d.name is string
            && d.name.size() > 0
            && d.name.size() <= 40
            && d.type in ['breb', 'nequi', 'daviplata', 'cash', 'other']
            && (d.type == 'breb'
                  ? d.keyType in ['phone', 'email', 'document', 'alias']
                  : d.get('keyType', null) == null)
            && d.reference is string
            && d.reference.size() <= 64
            && (d.type == 'cash' ? d.reference == '' : d.reference.size() > 0);
        }

        allow read: if isOwner(uid) || sharesGroupWith(uid);
        allow create: if isOwner(uid)
          && validAccount(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.deletedAt == null;
        // Edits and the soft delete (`deletedAt`, once).
        allow update: if isOwner(uid)
          && validAccount(request.resource.data)
          && resource.data.deletedAt == null
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.deletedAt == null
              || request.resource.data.deletedAt == request.time);
        allow delete: if false;
      }

      // users/{uid}/auditLog/{logId}: write-only log of the user's own
      // changes (payment accounts). Same shape as the group log.
      match /auditLog/{logId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['action', 'entity', 'entityId', 'before', 'after', 'uid', 'timestamp'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.timestamp == request.time;
        allow update, delete: if false;
      }

      // users/{uid}/fcmTokens/{token} → { token, createdAt, updatedAt, deletedAt }
      // Devices where the user receives push notifications. Only the owner
      // reads and writes them; the notifications Worker reads them (and
      // retires the ones FCM no longer knows) with a service account, which
      // these rules do not apply to. Retired with `deletedAt`, never deleted.
      match /fcmTokens/{token} {
        function t() {
          return request.resource.data;
        }

        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && t().keys().hasOnly(['token', 'createdAt', 'updatedAt', 'deletedAt'])
          && t().token == token
          && t().createdAt == request.time
          && t().updatedAt == request.time
          && t().deletedAt == null;
        // Seen again on this device (deletedAt back to null) or retired.
        allow update: if isOwner(uid)
          && t().diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'deletedAt'])
          && t().updatedAt == request.time
          && (t().deletedAt == null || t().deletedAt == request.time);
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // notificationLog/{key} → { type, groupId, actorUid, recipients, sentAt }
    // Notifications already sent, so each one goes out once. Written only
    // by the notifications Worker (service account); the app never reads
    // or writes it.
    // ---------------------------------------------------------------
    match /notificationLog/{key} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // userGroups/{uid} → { groupIds }
    // Groups where `uid` is an active member, so these rules can tell
    // whether two users share a group (rules cannot search the groups).
    // Kept in the same batch as each membership change; every write adds
    // or removes exactly one group, and must match that group's `members`
    // after the batch. Written by the user (create, join, leave, repairs)
    // or by an admin of that group (approve, remove).
    // ---------------------------------------------------------------
    match /userGroups/{uid} {
      function indexedBefore() {
        return resource == null ? [] : resource.data.get('groupIds', []);
      }

      function canTouch(gid) {
        return request.auth.uid == uid
          || request.auth.uid in adminsOf(get(groupDoc(gid)).data);
      }

      function validIndexChange() {
        let before = indexedBefore();
        let after = request.resource.data.groupIds;
        let added = after.removeAll(before);
        let removed = before.removeAll(after);
        return request.resource.data.keys().hasOnly(['groupIds'])
          && after is list
          && ((added.size() == 1
                && removed.size() == 0
                && uid in getAfter(groupDoc(added[0])).data.members
                && canTouch(added[0]))
              || (removed.size() == 1
                && added.size() == 0
                && !(uid in getAfter(groupDoc(removed[0])).data.members)
                && canTouch(removed[0])));
      }

      allow read: if isOwner(uid);
      allow create, update: if signedIn() && validIndexChange();
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // groupCodes/{code} → { gid, name, hasPassword, requiresApproval,
    //                       salt, createdAt, deletedAt? }
    // Unique join codes. Whoever knows a code can read its entry (to join),
    // but nobody can list them. `deletedAt` marks the code of an archived
    // group, which no longer works.
    // ---------------------------------------------------------------
    match /groupCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      // Only together with the creation of its group (same transaction).
      allow create: if signedIn()
        && code.matches('^[A-Z]{3}-[A-HJ-NP-Z2-9]{4}$')
        && request.resource.data.keys().hasOnly(
             ['gid', 'name', 'hasPassword', 'requiresApproval', 'salt', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/groups/$(request.resource.data.gid))
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.code == code
        && request.resource.data.name == getAfter(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.name
        && request.resource.data.hasPassword == getAfter(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.hasPassword
        && request.resource.data.requiresApproval == getAfter(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.requiresApproval
        && (request.resource.data.hasPassword
              ? request.resource.data.salt is string
              : request.resource.data.salt == null);
      function passwordDoc(gid) {
        return /databases/$(database)/documents/groups/$(gid)/secrets/password;
      }

      // Archiving: only `deletedAt`, by the owner, in the same batch that
      // archives the group.
      function validArchive() {
        return !('deletedAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt'])
          && request.resource.data.deletedAt == request.time
          && get(groupDoc(resource.data.gid)).data.ownerUid == request.auth.uid
          && getAfter(groupDoc(resource.data.gid)).data.deletedAt == request.time;
      }

      // "Editar grupo": an admin mirrors the name, the approval and the
      // password flag of the group (same batch). A new salt comes with a
      // new password hash.
      function validSettingsMirror() {
        let after = request.resource.data;
        let group = getAfter(groupDoc(resource.data.gid)).data;
        let pwd = passwordDoc(resource.data.gid);
        return resource.data.get('deletedAt', null) == null
          && after.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'requiresApproval', 'hasPassword', 'salt'])
          && request.auth.uid in adminsOf(get(groupDoc(resource.data.gid)).data)
          && after.name == group.name
          && after.requiresApproval == group.requiresApproval
          && after.hasPassword == group.hasPassword
          && (after.hasPassword ? after.salt is string : after.salt == null)
          && (after.salt == resource.data.salt
              || after.salt == null
              || (existsAfter(pwd)
                  && (!exists(pwd) || getAfter(pwd).data.hash != get(pwd).data.hash)));
      }

      allow update: if signedIn() && (validArchive() || validSettingsMirror());
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // groups/{groupId}
    //   members: [uid] (active)   pendingMembers: [uid] (awaiting approval)
    // ---------------------------------------------------------------
    match /groups/{groupId} {
      function groupPath() {
        return /databases/$(database)/documents/groups/$(groupId);
      }

      function memberPath(uid) {
        return /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
      }

      function isActiveMember() {
        return signedIn() && request.auth.uid in get(groupPath()).data.members;
      }

      // The group did not exist before this request (creation batch).
      function isBeingCreatedBy(uid) {
        return !exists(groupPath())
          && getAfter(groupPath()).data.ownerUid == uid;
      }

      function validNewGroup(d) {
        return d.keys().hasOnly(['name', 'code', 'ownerUid', 'admins',
                                 'requiresApproval', 'hasPassword', 'members',
                                 'pendingMembers', 'createdAt', 'updatedAt',
                                 'deletedAt'])
          && d.name is string
          && d.name.trim().size() >= 3
          && d.name.size() <= 40
          && d.ownerUid == request.auth.uid
          && d.admins == [request.auth.uid]
          && d.members == [request.auth.uid]
          && d.pendingMembers == []
          && d.requiresApproval is bool
          && d.hasPassword is bool
          && d.hasPassword == existsAfter(/databases/$(database)/documents/groups/$(groupId)/secrets/password)
          && getAfter(/databases/$(database)/documents/groupCodes/$(d.code)).data.gid == groupId
          && getAfter(memberPath(request.auth.uid)).data.role == 'admin'
          && d.createdAt == request.time
          && d.updatedAt == request.time
          && d.deletedAt == null;
      }

      // Joining: the caller appends only themselves to `members` (no
      // approval needed) or to `pendingMembers`, matching the member
      // document written in the same batch.
      function validJoin() {
        let before = resource.data;
        let after = request.resource.data;
        let status = getAfter(memberPath(request.auth.uid)).data.status;
        return after.diff(before).affectedKeys().hasOnly(['members', 'pendingMembers', 'updatedAt'])
          && after.updatedAt == request.time
          && before.deletedAt == null
          && !(request.auth.uid in before.members)
          && !(request.auth.uid in before.pendingMembers)
          && (status == 'active'
              ? after.members == before.members.concat([request.auth.uid])
                && after.pendingMembers == before.pendingMembers
              : after.pendingMembers == before.pendingMembers.concat([request.auth.uid])
                && after.members == before.members);
      }

      // Leaving (or withdrawing a request): the caller removes only
      // themselves, and their member document is marked `left` in the same
      // batch. An admin who leaves stops being one. When the owner leaves,
      // the oldest other admin (the first of `admins`, in promotion order)
      // becomes the owner or, without other admins, the oldest active
      // member (the first of `members`, in join order), who becomes an
      // admin; if nobody is left, the group is archived.
      function validLeave() {
        let me = request.auth.uid;
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        let otherAdmins = adminsOf(before).removeAll([me]);
        return getAfter(memberPath(me)).data.status == 'left'
          && after.updatedAt == request.time
          && before.deletedAt == null
          && (me in before.members
              ? after.members == before.members.removeAll([me])
                && after.pendingMembers == before.pendingMembers
                && (before.ownerUid != me
                    ? changed.hasOnly(['members', 'admins', 'updatedAt'])
                      && adminsOf(after) == otherAdmins
                    : (after.members.size() > 0
                        ? changed.hasOnly(['members', 'ownerUid', 'admins', 'updatedAt'])
                          && after.admins == (otherAdmins.size() > 0
                                               ? otherAdmins
                                               : [after.members[0]])
                          && after.ownerUid == after.admins[0]
                          && getAfter(memberPath(after.ownerUid)).data.role == 'admin'
                        : changed.hasOnly(['members', 'deletedAt', 'updatedAt'])
                          && after.deletedAt == request.time))
              : me in before.pendingMembers
                && after.pendingMembers == before.pendingMembers.removeAll([me])
                && changed.hasOnly(['pendingMembers', 'updatedAt']));
      }

      // Admin changes, by any admin: remove one active member (only the
      // owner removes another admin; nobody removes the owner), approve or
      // reject one pending request, promote one active member, demote one
      // admin (only the owner) or edit the settings. `removeAll` between
      // the lists tells who is affected; their member document must change
      // in the same batch.
      function validAdminChange() {
        let me = request.auth.uid;
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        let adminsBefore = adminsOf(before);
        let adminsAfter = adminsOf(after);
        let gone = before.members.removeAll(after.members);
        let answered = before.pendingMembers.removeAll(after.pendingMembers);
        let promoted = adminsAfter.removeAll(adminsBefore);
        let demoted = adminsBefore.removeAll(adminsAfter);
        return me in adminsBefore
          && before.deletedAt == null
          && after.updatedAt == request.time
          && (
            // Remove an active member (an admin also stops being one).
            (changed.hasOnly(['members', 'admins', 'updatedAt'])
              && gone.size() == 1
              && gone[0] != before.ownerUid
              && gone[0] != me
              && after.members == before.members.removeAll(gone)
              && adminsAfter == adminsBefore.removeAll(gone)
              && (!(gone[0] in adminsBefore) || before.ownerUid == me)
              && getAfter(memberPath(gone[0])).data.status == 'removed')
            // Approve a request: appended to `members` (join order).
            || (changed.hasOnly(['members', 'pendingMembers', 'updatedAt'])
              && answered.size() == 1
              && after.pendingMembers == before.pendingMembers.removeAll(answered)
              && after.members == before.members.concat(answered)
              && getAfter(memberPath(answered[0])).data.status == 'active')
            // Reject a request.
            || (changed.hasOnly(['pendingMembers', 'updatedAt'])
              && answered.size() == 1
              && after.pendingMembers == before.pendingMembers.removeAll(answered)
              && getAfter(memberPath(answered[0])).data.status == 'removed')
            // Promote an active member: appended to `admins`.
            || (changed.hasOnly(['admins', 'updatedAt'])
              && promoted.size() == 1
              && demoted.size() == 0
              && adminsAfter == adminsBefore.concat(promoted)
              && promoted[0] in before.members
              && getAfter(memberPath(promoted[0])).data.role == 'admin')
            // Demote an admin (only the owner, never themselves).
            || (changed.hasOnly(['admins', 'updatedAt'])
              && before.ownerUid == me
              && demoted.size() == 1
              && promoted.size() == 0
              && demoted[0] != before.ownerUid
              && adminsAfter == adminsBefore.removeAll(demoted)
              && getAfter(memberPath(demoted[0])).data.role == 'member')
            // Edit the name, the approval or the password (the join code
            // and the password hash change in the same batch).
            || (changed.hasOnly(['name', 'requiresApproval', 'hasPassword', 'updatedAt'])
              && after.name is string
              && after.name.trim().size() >= 3
              && after.name.size() <= 40
              && after.requiresApproval is bool
              && after.hasPassword is bool
              && (!after.hasPassword
                  || existsAfter(/databases/$(database)/documents/groups/$(groupId)/secrets/password))
              && getAfter(/databases/$(database)/documents/groupCodes/$(before.code)).data.name == after.name
              && getAfter(/databases/$(database)/documents/groupCodes/$(before.code)).data.requiresApproval == after.requiresApproval
              && getAfter(/databases/$(database)/documents/groupCodes/$(before.code)).data.hasPassword == after.hasPassword)
          );
      }

      // Active and pending members see the group (pending ones see its
      // name and size in the selector).
      allow read: if signedIn()
        && (request.auth.uid in resource.data.members
            || request.auth.uid in resource.data.pendingMembers);
      allow create: if signedIn() && validNewGroup(request.resource.data);
      allow update: if signedIn()
        && (validJoin() || validLeave() || validAdminChange());
      allow delete: if false;

      // groups/{groupId}/members/{uid}
      //   → { role, status, joinedAt, leftAt?, removedAt?, removedBy? }
      // status: active | pending | left | removed. Whoever leaves (or is
      // removed) keeps the document (soft delete) and may join again with
      // the code.
      match /members/{uid} {
        function validMember(role, status) {
          return request.resource.data.keys().hasOnly(['role', 'status', 'joinedAt'])
            && request.resource.data.role == role
            && request.resource.data.status == status
            && request.resource.data.joinedAt == request.time;
        }

        function passwordMatches() {
          let group = get(groupPath()).data;
          return !group.hasPassword
            || getAfter(/databases/$(database)/documents/groups/$(groupId)/joinProofs/$(uid)).data.hash
               == get(/databases/$(database)/documents/groups/$(groupId)/secrets/password).data.hash;
        }

        function isGroupAdmin() {
          return request.auth.uid in adminsOf(get(groupPath()).data);
        }

        allow get: if isOwner(uid) || isActiveMember();
        allow list: if isActiveMember();
        // Anyone with the code: a plain member, pending if the group
        // requires approval, and only with the right password.
        function validJoiner() {
          return exists(groupPath())
            && validMember('member',
                 get(groupPath()).data.requiresApproval ? 'pending' : 'active')
            && passwordMatches()
            && getAfter(groupPath()).data.updatedAt == request.time;
        }

        allow create: if isOwner(uid) && (
          // The creator, while creating the group.
          (isBeingCreatedBy(uid) && validMember('admin', 'active'))
          || validJoiner()
        );

        allow update: if signedIn() && (
          // Leaving: the member marks their own document `left`, as a plain
          // member, in the batch that removes them from the group.
          (isOwner(uid)
            && resource.data.status in ['active', 'pending']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['role', 'status', 'leftAt'])
            && request.resource.data.role == 'member'
            && request.resource.data.status == 'left'
            && request.resource.data.leftAt == request.time
            && !(uid in getAfter(groupPath()).data.members)
            && !(uid in getAfter(groupPath()).data.pendingMembers))
          // Joining again after leaving or being removed (same checks as a
          // new joiner).
          || (isOwner(uid)
            && resource.data.status in ['left', 'removed']
            && validJoiner())
          // Role changes by an admin (promote, demote, or the leaving owner
          // handing over): `role` follows the group's `admins` after the
          // batch, whose own rule decides who may change it.
          || (!isOwner(uid)
            && isGroupAdmin()
            && resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role in ['admin', 'member']
            && (request.resource.data.role == 'admin')
                 == (uid in adminsOf(getAfter(groupPath()).data)))
          // An admin removes an active member or rejects a request (a
          // removed admin stops being one).
          || (isGroupAdmin()
            && !isOwner(uid)
            && resource.data.status in ['active', 'pending']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['role', 'status', 'removedAt', 'removedBy'])
            && request.resource.data.role == 'member'
            && request.resource.data.status == 'removed'
            && request.resource.data.removedAt == request.time
            && request.resource.data.removedBy == request.auth.uid
            && !(uid in getAfter(groupPath()).data.members)
            && !(uid in getAfter(groupPath()).data.pendingMembers))
          // An admin approves a request: active from now on.
          || (isGroupAdmin()
            && !isOwner(uid)
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'joinedAt'])
            && request.resource.data.status == 'active'
            && request.resource.data.joinedAt == request.time
            && uid in getAfter(groupPath()).data.members)
        );
        allow delete: if false;
      }

      // groups/{groupId}/secrets/password → { hash }
      // Salted SHA-256 of the group password. Never readable: only the
      // rules compare it.
      match /secrets/{doc} {
        function validHash() {
          return doc == 'password'
            && request.resource.data.keys().hasOnly(['hash'])
            && request.resource.data.hash is string;
        }

        // "Editar grupo": an admin sets a new password, with a new salt in
        // the join code (same batch).
        function validPasswordChange() {
          let code = get(groupPath()).data.code;
          let codePath = /databases/$(database)/documents/groupCodes/$(code);
          return exists(groupPath())
            && request.auth.uid in adminsOf(get(groupPath()).data)
            && getAfter(groupPath()).data.hasPassword == true
            && getAfter(groupPath()).data.updatedAt == request.time
            && getAfter(codePath).data.salt != get(codePath).data.salt;
        }

        allow read: if false;
        allow create: if signedIn()
          && validHash()
          && (isBeingCreatedBy(request.auth.uid) || validPasswordChange());
        allow update: if signedIn() && validHash() && validPasswordChange();
        allow delete: if false;
      }

      // groups/{groupId}/joinProofs/{uid} → { hash }
      // Hash of the password a user typed to join. Never readable.
      match /joinProofs/{uid} {
        allow read: if false;
        // Only in the batch that joins (or joins again after leaving or
        // being removed).
        function validProof() {
          return isOwner(uid)
            && exists(groupPath())
            && (!exists(memberPath(uid))
                || get(memberPath(uid)).data.status in ['left', 'removed'])
            && getAfter(memberPath(uid)).data.status in ['active', 'pending']
            && request.resource.data.keys().hasOnly(['hash'])
            && request.resource.data.hash is string;
        }

        allow create, update: if validProof();
        allow delete: if false;
      }

      // groups/{groupId}/movements/{movementId}
      //   → { type (debt|payment), debtorUid, creditorUid, participants,
      //       pairKey (both uids sorted, joined with _), amount, kind?, eventId?, eventName?, concept, appliedTo?,
      //       account?, note?, attachment?, date, createdBy, createdAt,
      //       status (active|rejected|deleted), rejectedAt?, rejectedBy?,
      //       rejectReason?, rejectNote?, deletedAt?, seenBy }
      // The ledger balances are computed from. Applied as soon as it is
      // written; never edited: its recipient (the party that did not write
      // it) may reject it once, its author may delete it (soft delete), and
      // either party marks it as seen. The rules cannot check that
      // `appliedTo` matches the pending debts (accepted risk among friends).
      match /movements/{movementId} {
        function d() {
          return request.resource.data;
        }

        function optionalString(field, max) {
          return !(field in d())
            || d()[field] == null
            || (d()[field] is string && d()[field].size() <= max);
        }

        function validNewMovement() {
          return d().keys().hasOnly(['type', 'debtorUid', 'creditorUid',
               'participants', 'pairKey', 'amount', 'kind', 'eventId', 'eventName',
               'concept', 'appliedTo', 'account', 'note', 'attachment',
               'date', 'createdBy', 'createdAt', 'status', 'seenBy'])
            && d().type in ['debt', 'payment']
            && d().debtorUid is string
            && d().creditorUid is string
            && d().debtorUid != d().creditorUid
            && d().participants == [d().debtorUid, d().creditorUid]
            && d().pairKey == (d().debtorUid < d().creditorUid
              ? d().debtorUid + '_' + d().creditorUid
              : d().creditorUid + '_' + d().debtorUid)
            && request.auth.uid in d().participants
            && d().createdBy == request.auth.uid
            && d().amount is int
            && d().amount > 0
            && d().amount <= 100000000
            && d().concept is string
            && d().concept.size() <= 60
            && optionalString('eventId', 128)
            && optionalString('eventName', 120)
            && optionalString('note', 120)
            && d().date is timestamp
            && d().createdAt == request.time
            && d().status == 'active'
            && d().seenBy == [request.auth.uid]
            && (d().type == 'debt'
              ? d().kind in ['event', 'direct']
                && d().concept.size() > 0
                && !('appliedTo' in d())
              : d().appliedTo is list
                && d().appliedTo.size() <= 50
                && !('kind' in d()));
        }

        function changed() {
          return d().diff(resource.data).affectedKeys();
        }

        // seenBy only gains the signed-in user.
        function seenByMe() {
          return d().seenBy.toSet()
            == resource.data.seenBy.toSet().union([request.auth.uid].toSet());
        }

        function validReject() {
          return resource.data.status == 'active'
            && request.auth.uid in resource.data.participants
            && request.auth.uid != resource.data.createdBy
            && changed().hasOnly(['status', 'rejectedAt', 'rejectedBy',
                 'rejectReason', 'rejectNote', 'seenBy'])
            && d().status == 'rejected'
            && d().rejectedAt == request.time
            && d().rejectedBy == request.auth.uid
            && d().rejectReason in ['not_received', 'wrong_amount', 'other']
            && optionalString('rejectNote', 80)
            && seenByMe();
        }

        function validDelete() {
          return resource.data.status == 'active'
            && request.auth.uid == resource.data.createdBy
            && changed().hasOnly(['status', 'deletedAt'])
            && d().status == 'deleted'
            && d().deletedAt == request.time;
        }

        function validSeen() {
          return request.auth.uid in resource.data.participants
            && changed().hasOnly(['seenBy'])
            && seenByMe();
        }

        allow read: if isActiveMember();
        allow create: if isActiveMember() && validNewMovement();
        allow update: if isActiveMember()
          && (validReject() || validDelete() || validSeen());
        allow delete: if false;
      }

      // groups/{groupId}/auditLog/{logId}: write-only change log.
      match /auditLog/{logId} {
        allow read: if isActiveMember();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(
               ['action', 'entity', 'entityId', 'before', 'after', 'uid', 'timestamp'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.timestamp == request.time
          && existsAfter(memberPath(request.auth.uid));
        allow update, delete: if false;
      }
    }
  }
}
